# Create an API key in https://platform.openai.com/api-keys and never expose it in the browser.
OPENAI_API_KEY=

# Any current text model that supports file inputs and structured outputs.
OPENAI_DIAGNOSTIC_MODEL=gpt-4o-mini
OPENAI_ASSET_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional remote persistence. Create the table shown in README before setting these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
